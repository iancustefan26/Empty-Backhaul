# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session" pooler (port 5432) for Alembic migrations.
# Format: postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:CHANGE_ME_paste_your_pooler_password_here@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Optional: app config
APP_ENV=development
LOG_LEVEL=INFO

# ---- Analyst LLM provider ----
# Choose one of: auto (default), vertex, gemini, anthropic, mock
# `auto` resolution order (first key found wins):
#   1. VERTEX_AI_API_KEY    -> Vertex AI Express Mode (preferred)
#   2. GEMINI_API_KEY        -> AI Studio (AIza...) or Vertex (AQ.* prefix)
#   3. ANTHROPIC_API_KEY     -> Claude
#   4. otherwise             -> Mock (deterministic, no LLM)
LLM_PROVIDER=auto

# --- Vertex AI Express Mode (recommended — uses GCP credit / free trial) ---
# Sign in at console.cloud.google.com, enable the Vertex AI API, then
# create an API key under "APIs & Services -> Credentials". Key starts
# with "AQ.". Default throttle: 60 RPM, 10 000 RPD (well below the
# tier 1 ceiling of 500 RPM / unlimited daily). Tune via:
#   VERTEX_RPM_CAP=120          # safe up to ~250 on Express tier 1
#   VERTEX_DAILY_CAP=10000      # raise on paid billing
VERTEX_AI_API_KEY=
# VERTEX_MODEL=gemini-2.5-flash

# --- Google AI Studio (free tier — only 10 RPM / 250 RPD) ---
# Get a key at https://aistudio.google.com/apikey  (starts with "AIza")
# Slow for interactive use; fine for batch scripts with warm cache.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash    # override the default model

# Anthropic Claude (paid). Leave blank to skip.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Set LLM_CACHE=0 to disable the on-disk response cache under backend/.llm_cache/
# (the cache is on by default and saves money on repeated demo runs).
LLM_CACHE=1

CHROMA_PERSIST_DIR=./chroma_db
