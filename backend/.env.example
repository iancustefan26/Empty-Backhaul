# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session" pooler (port 5432) for Alembic migrations.
# Format: postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:CHANGE_ME_paste_your_pooler_password_here@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Optional: app config
APP_ENV=development
LOG_LEVEL=INFO

# ---- Analyst LLM provider ----
# Choose one of: auto (default), vertex, gemini, anthropic, mock
# `auto` resolution order (first key found wins):
#   1. VERTEX_AI_API_KEY    -> Vertex AI Express Mode (preferred)
#   2. GEMINI_API_KEY        -> AI Studio (AIza...) or Vertex (AQ.* prefix)
#   3. ANTHROPIC_API_KEY     -> Claude
#   4. otherwise             -> Mock (deterministic, no LLM)
LLM_PROVIDER=auto

# --- Vertex AI: pick ONE of the two auth modes below ---

# Mode 1: Application Default Credentials (RECOMMENDED for paid usage)
# ----------------------------------------------------------------------
# Run this once on the dev box to set up gcloud + browser sign-in:
#   bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
# Then set the project ID below. No JSON file, no API key — the SDK
# picks up credentials from ~/.config/gcloud automatically.
# Hits STANDARD Vertex quotas (~2 000 RPM Flash, no daily cap beyond
# what billing allows). Charges count against the project's billing.
GCP_PROJECT=
# GCP_LOCATION=us-central1     # default; override if you want another region

# Mode 2: Express Mode API key (faster setup, lower quotas)
# ----------------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# Key starts with "AQ.". Express Mode tier 1 = 500 RPM, 25 k req/day.
VERTEX_AI_API_KEY=
# VERTEX_MODEL=gemini-2.5-flash

# Throttle (applies in both modes; defaults are conservative)
#   VERTEX_RPM_CAP=120          # safe up to ~250 on Express, ~1000 on ADC
#   VERTEX_DAILY_CAP=10000      # raise after measuring

# --- Google AI Studio (free tier — only 10 RPM / 250 RPD) ---
# Get a key at https://aistudio.google.com/apikey  (starts with "AIza")
# Slow for interactive use; fine for batch scripts with warm cache.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash    # override the default model

# Anthropic Claude (paid). Leave blank to skip.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Set LLM_CACHE=0 to disable the on-disk response cache under backend/.llm_cache/
# (the cache is on by default and saves money on repeated demo runs).
LLM_CACHE=1

CHROMA_PERSIST_DIR=./chroma_db
